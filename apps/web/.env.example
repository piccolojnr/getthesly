APP_NAME=getthesly
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=getthesly
DB_USERNAME=postgres
DB_PASSWORD=

QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=true
CACHE_STORE=database

ANALYSIS_SERVICE_URL=http://127.0.0.1:8100
ANALYSIS_SERVICE_TOKEN=replace-with-a-long-random-url-safe-secret
ANALYSIS_SERVICE_CONNECT_TIMEOUT=2
ANALYSIS_SERVICE_TIMEOUT=8

RESEARCH_AI_PROVIDER=openai
RESEARCH_AI_MODEL=gpt-4.1-mini
RESEARCH_AI_TIMEOUT_SECONDS=20
RESEARCH_AI_RATE_LIMIT_ATTEMPTS=5
RESEARCH_AI_RATE_LIMIT_DECAY_SECONDS=600
RESEARCH_DRAFT_RETENTION_DAYS=30
OPENAI_API_KEY=
